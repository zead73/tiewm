# tiewm configuration.  Copy to ~/.config/tiewm/tiewm.conf and edit:
#   mkdir -p ~/.config/tiewm && cp tiewm.conf.example ~/.config/tiewm/tiewm.conf
#
# Check a file without starting anything:   tiewm --check-config [FILE]
# Keys can be reloaded in a running tiewm:  pkill -HUP -x tiewm   (everything else needs a restart/re-login)
# A bad line is only a warning: tiewm keeps the default for it and still starts.
# Comments are whole lines starting with # or ; (not after a value).  The values shown are the defaults.

[general]
# Any xfwm4 theme folder name from /usr/share/themes/<name>/xfwm4 or ~/.themes/<name>/xfwm4
# (installed here: Daloa, Default, Default-hdpi, Default-xhdpi, Kokodi, Moheli, Nordic).
# An unknown name falls back to Daloa.
#theme = Daloa

# Pango-style font name: family, optional Bold/Italic/Light, then the size in points.
#title_font = Sans Bold 11

# Titlebar buttons.  O menu, T stick, S shade, H hide (minimize), M maximize, C close.
# Letters before "|" go on the left, after it on the right.  (T is not implemented.)
#button_layout = O|SHMC

# left, center or right
#title_align = left

# Font of the window menu (right-click the titlebar, click the menu button, or Alt+space).
#menu_font = Sans 10

# Windows without a titlebar (apps that draw their own, or ones set to "No titlebar") normally get no frame at
# all.  This adds a thin resize border of that many pixels (0..16) around them, drawn in the palette colour
# (blue when focused, grey otherwise) and gone while the window is maximized or fullscreen.  0 = no border:
# those windows then resize with Alt+right-drag or Alt+F8.
#undecorated_border = 0

# Number of workspaces, 1..20.
#desktops = 4

# Title font rendering: greyscale antialiasing and hinting (0 none, 1 slight, 2 medium, 3 full, -1 = fontconfig's choice).
#font_greyscale = true
#font_hinting = 3

# Log file: startup, managed/unmanaged windows, config warnings, reloads and any internal error.
# Level off, info or debug (debug adds X protocol errors, which are normal when windows vanish).
# One generation is kept: a log over 512 KiB is moved to <file>.1 at start.  `tiewm --log` prints the path.
#log_file = ~/.local/state/tiewm/tiewm.log
#log_level = info

[colors]
# xfwm4 themes take their colours from the GTK theme; these are the base colours tiewm uses
# (measured from xfwm4 with Adwaita-dark).  Highlights and shadows are derived from them.
#active_color_1 = #14529E
#inactive_color_1 = #323232
#active_color_2 = #353535
#inactive_color_2 = #353535
#inactive_text_color = #919190

[keys]
# action = Combo[, Combo ...]     "none" disables an action.
# Listing an action replaces ALL of its default bindings; actions you do not list keep theirs.
# Combos: modifiers Ctrl, Alt, Shift, Super (also Control, Mod1, Mod4, Meta) joined by +, then an
# X keysym name: Tab, Return, Left, Right, F4, a, 2, ...  Caps Lock and Num Lock never matter.
#close = Alt+F4
#cycle = Alt+Tab
#cycle_back = Alt+Shift+Tab
#maximize = Super+Return
#iconify = Alt+F9
#fullscreen = Alt+F11
#desktop_left = Ctrl+Alt+Left
#desktop_right = Ctrl+Alt+Right
# move_left / move_right: move the focused window one desktop over and follow it
#move_left = Ctrl+Alt+Shift+Left
#move_right = Ctrl+Alt+Shift+Right
# window_menu: open the window menu for the focused window (also: right-click the titlebar)
#window_menu = Alt+space
# shade: roll the focused window up to its titlebar (also the S button and the window menu); no default key
#shade =
# move_window / resize_window: keyboard move/resize of the focused window. Arrow keys move or resize by
# 10 px (Shift: 1 px), Return confirms, Escape cancels.
#move_window = Alt+F7
#resize_window = Alt+F8
#
# Direct desktop keys (none by default; Ctrl+F1..F12 are already taken by lxqt-globalkeyshortcuts):
#goto_desktop_1 = Super+1
#goto_desktop_2 = Super+2
#move_to_desktop_1 = Super+Shift+1

[windows]
# Per-application window rules, matched by WM_CLASS (the class or the instance name, any case;
# `xprop WM_CLASS` on a window shows both).  Values: titlebar | no_titlebar.
# These override what an app asks for itself (apps such as Electron ones that draw their own
# titlebar already get none without a rule).
# tiewm writes these lines itself: choose "No titlebar" in a window's menu (Alt+space, or right-click
# the titlebar) and the rule for that application is added here; choosing what the app asks for
# removes it again.  The rest of the file, comments included, is left exactly as it is.
# Rules apply to windows opened afterwards; `pkill -HUP -x tiewm` re-reads hand edits.
#com.example.SomeApp = no_titlebar
#SomeOtherApp = titlebar
